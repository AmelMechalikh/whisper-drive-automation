{
  "manifest_version": 3,
  "name": "Marqueur Segments Vidéo",
  "version": "1.1.0",
  "description": "Marquez facilement les segments vidéo dans vos Google Docs avec des balises inline",
  "permissions": [
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "https://docs.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "996015165236-519e6dpst86jebca11gig6o7ldjm8shu.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/documents"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/document/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
