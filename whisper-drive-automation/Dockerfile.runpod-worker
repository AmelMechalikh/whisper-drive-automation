FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install Python dependencies
COPY requirements-runpod.txt .
RUN pip install --no-cache-dir -r requirements-runpod.txt

# Copy source code
COPY src/ ./src/
COPY scripts/runpod_transcription_worker.py ./scripts/
COPY scripts/runpod_worker_http.py ./scripts/
COPY config/ ./config/

# Set PYTHONPATH
ENV PYTHONPATH=/app/src:/app

# Run the HTTP wrapper (which starts the worker in background)
CMD ["python", "scripts/runpod_worker_http.py"]
